{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixray.dev/schema/trackmap.schema.json",
  "title": "TrackMap",
  "description": "Engine output for one clip (≤ 30 s). The only contract between engine/ and apps/web/. Times are seconds from the start of the clip. Each sound the user picks is one entry in `isolations`.",
  "type": "object",
  "required": ["version", "id", "source", "duration", "tempo", "beats", "downbeats", "key", "chords", "sections", "energy", "suggestions", "isolations"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "id": { "type": "string", "description": "SHA-256 of the decoded clip (cache key)." },
    "source": {
      "type": "object",
      "required": ["kind", "title", "clip_start", "clip_end"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["audio", "video"] },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "license": { "type": "string", "description": "e.g. 'owned', 'CC BY 4.0'." },
        "clip_start": { "type": "number", "minimum": 0, "description": "Offset of the clip in the original file." },
        "clip_end": { "type": "number", "minimum": 0 },
        "mix_url": { "type": "string", "description": "Full-mix audio of the clip for playback." }
      }
    },
    "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
    "tempo": {
      "type": "object",
      "required": ["bpm", "time_signature", "confidence"],
      "additionalProperties": false,
      "properties": {
        "bpm": { "type": "number", "minimum": 40, "maximum": 220 },
        "time_signature": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "beats": { "type": "array", "items": { "type": "number", "minimum": 0 } },
    "downbeats": { "type": "array", "items": { "type": "number", "minimum": 0 }, "description": "Bar starts; bar index = position in this array." },
    "key": {
      "type": "object",
      "required": ["tonic", "mode", "confidence"],
      "additionalProperties": false,
      "properties": {
        "tonic": { "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"] },
        "mode": { "enum": ["major", "minor"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "chords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bar", "start", "end", "label"],
        "additionalProperties": false,
        "properties": {
          "bar": { "type": "integer", "minimum": 0 },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "label": { "type": "string", "description": "e.g. 'Am', 'F', or 'N' for no chord." },
          "root_midi": { "type": "integer", "minimum": 0, "maximum": 127 }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "label"],
        "additionalProperties": false,
        "properties": {
          "start": { "type": "number" },
          "end": { "type": "number" },
          "label": { "enum": ["intro", "verse", "build", "drop", "breakdown", "chorus", "bridge", "outro", "section"] }
        }
      }
    },
    "energy": {
      "type": "object",
      "required": ["hop", "values"],
      "additionalProperties": false,
      "properties": {
        "hop": { "type": "number", "exclusiveMinimum": 0 },
        "values": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "summary": { "type": "string", "description": "One-line Muse summary of the clip." },
    "suggestions": {
      "type": "array",
      "description": "Sounds Muse Spark hears in the clip, offered as chips.",
      "items": {
        "type": "object",
        "required": ["label", "prompt"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "description": "Short UI label, e.g. 'Supersaw lead'." },
          "prompt": { "type": "string", "description": "Text prompt sent to SAM Audio." }
        }
      }
    },
    "isolations": {
      "type": "array",
      "items": { "$ref": "#/$defs/isolation" }
    },
    "fallback_stems": {
      "type": "array",
      "description": "Demucs stems, computed once per clip; used when a prompt maps to a standard instrument.",
      "items": {
        "type": "object",
        "required": ["name", "url", "level"],
        "additionalProperties": false,
        "properties": {
          "name": { "enum": ["vocals", "drums", "bass", "guitar", "piano", "other"] },
          "url": { "type": "string" },
          "wav_url": { "type": "string" },
          "level": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "video": {
      "type": "object",
      "description": "Present only for video clips.",
      "required": ["url", "fps", "width", "height", "tracks"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "description": "720p web copy of the clip." },
        "fps": { "type": "number", "description": "Mask frame rate (10)." },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "masks_url", "visible"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string", "description": "e.g. 'Keyboard player'." },
              "prompt": { "type": "string", "description": "Text prompt or 'tap@x,y' used for SAM 3.1." },
              "masks_url": { "type": "string", "description": "JSON with one polygon list per frame." },
              "visible": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "description": "[start, end] ranges where the object is on screen." },
              "isolation_id": { "type": "string", "description": "Isolation produced from this track, once requested." }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "required": ["start", "end", "pitch", "velocity"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "bar": { "type": "integer", "minimum": 0 },
        "hand": { "enum": ["right", "left"] }
      }
    },
    "noteList": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "isolation": {
      "type": "object",
      "required": ["id", "label", "prompt", "method", "sound_url", "rest_url", "peaks", "notes", "arrangements"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "SHA-256 of clip id + prompt." },
        "label": { "type": "string" },
        "prompt": { "type": "string" },
        "method": { "enum": ["sam_audio_text", "sam_audio_visual", "demucs"] },
        "sound_url": { "type": "string" },
        "sound_wav_url": { "type": "string" },
        "rest_url": { "type": "string" },
        "peaks": { "type": "array", "items": { "type": "number" } },
        "rest_peaks": { "type": "array", "items": { "type": "number" } },
        "pitch_confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Mean transcription confidence; drives the Demucs fallback choice." },
        "range": {
          "type": "object",
          "required": ["low", "high"],
          "additionalProperties": false,
          "properties": { "low": { "type": "integer" }, "high": { "type": "integer" } }
        },
        "notes": { "$ref": "#/$defs/noteList", "description": "Transcribed notes, snapped to the beat grid." },
        "arrangements": {
          "type": "object",
          "required": ["easy"],
          "additionalProperties": false,
          "properties": {
            "easy": { "$ref": "#/$defs/noteList", "description": "Right-hand part, MIDI 60-84." },
            "intermediate": { "$ref": "#/$defs/noteList", "description": "Plus left-hand root+fifth per bar." }
          }
        },
        "summary": { "type": "string", "description": "One-line Muse description of this sound." },
        "recipe": { "type": "object", "description": "Sound recipe JSON from Muse Spark Open." }
      }
    }
  }
}
