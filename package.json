{
  "name": "mixray",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mixray/web dev",
    "build": "pnpm --filter @mixray/web build",
    "lint": "pnpm --filter @mixray/web lint",
    "typecheck": "pnpm --filter @mixray/web typecheck",
    "test": "pnpm --filter @mixray/web test",
    "gen:types": "pnpm --filter @mixray/web gen:types"
  }
}
